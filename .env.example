# ============================================================================
# OLUDAX CONCEPT - Environment Variables Configuration
# ============================================================================

# Supabase Database & Auth (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack Payment Gateway (https://paystack.com)
# Use pk_test_ and sk_test_ for development/staging; use pk_live_ and sk_live_ for production.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# Admin Portal & Staff Security (Restricted Access)
# ============================================================================
# Define strong credentials for the /admin staff portal.
# If not specified, the system defaults to "admin@oludaxconcept.com" with a secure default passkey.
ADMIN_EMAIL=admin@oludaxconcept.com
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_SECRET_TOKEN=generate_a_random_64_character_hex_secret_here

